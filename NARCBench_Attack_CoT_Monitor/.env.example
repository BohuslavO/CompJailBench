# Copy this file to .env and fill only the provider you actually use.
# Never commit .env and never paste secret values into chat or Slack.

# OpenAI-compatible provider example
OPENAI_API_KEY=

# AWS Bedrock bearer key (simplest for openai/bedrock/* models)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=

# Alternative: standard AWS credentials (do not combine with the bearer key)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=

# Azure OpenAI example
AZUREAI_OPENAI_API_KEY=
AZUREAI_OPENAI_BASE_URL=
